<?xml version="1.0" encoding="UTF-8"?>

<!-- When creating a new activity, make a copy of this file with appropriate name -->
<worksheet xml:id="exam-02">
  <title>Exam 2</title>

  <!-- Optional introduction -->
  <introduction>
    <p>
      Show all relevant work.
    </p>
  </introduction>


  <page>
    <exercise>
      <introduction>
        <p>
          For each of the following questions, circle one answer A<ndash />E.
          No justification is necessary.
        </p>
      </introduction>


      <task>
        <statement>
          <p>
            Which of the following is <m>\displaystyle{\mathcal{L}\left\{\cos(-t) \ast e^{2t}\right\}}</m>?
          </p>

          <p>
            <ol marker="A.">
              <li>
                <p>
                  <m>\displaystyle{\frac{-1}{s^2 - 2}}</m>
                </p>
              </li>

              <li>
                <p>
                  <m>\displaystyle{\frac{2e^{-2s}}{s^2 + 1}}</m>
                </p>
              </li>

              <li>
                <p>
                  <m>\displaystyle{\frac{s}{(s^2 + 1)(s - 2)}}</m>
                </p>
              </li>

              <li>
                <p>
                  <m>\displaystyle{\frac{1}{(s^2 + 1)(s - 2)}}</m>
                </p>
              </li>

              <li>
                <p>
                  <m>\displaystyle{\frac{-1}{(s^2 + 1)(s - 2)}}</m>
                </p>
              </li>
            </ol>
          </p>
        </statement>

        <solution>
          <p>
            C.
          </p>
        </solution>
      </task>


      <task>
        <statement>
          <p>
            Which of the following is the Laplace transform of <m>f(t) = u(t-4)e^{2t}</m>?
            <ol marker="A.">
              <li>
                <p>
                  <m>\displaystyle{\frac{e^{2 - s}}{s + 4}}</m>
                </p>
              </li>

              <li>
                <p>
                  <m>\displaystyle{\frac{e^{-4s}}{s - 2}}</m>
                </p>
              </li>

              <li>
                <p>
                  <m>\displaystyle{\frac{1}{s - 2}}</m>
                </p>
              </li>

              <li>
                <p>
                  <m>\displaystyle{\frac{e^{8 - 4s}}{s - 2}}</m>
                </p>
              </li>

              <li>
                <p>
                  <m>\displaystyle{\frac{e^{-2s}}{s - 4}}</m>
                </p>
              </li>
            </ol>
          </p>
        </statement>

        <solution>
          <p>
            D.
          </p>
        </solution>
      </task>


      <task>
        <statement>
          <p>
            For what value of <m>x</m> does the matrix <m>\displaystyle{A = \begin{bmatrix} x \amp 2x \\ -3x \amp 6\end{bmatrix}}</m> <em>not</em> have an inverse?
          </p>

          <p>
            <ol marker="A.">
              <li>
                <p>
                  <m>x = -1</m>
                </p>
              </li>

              <li>
                <p>
                  <m>x = 1/6</m>
                </p>
              </li>

              <li>
                <p>
                  <m>x = 6</m>
                </p>
              </li>

              <li>
                <p>
                  <m>x = 2</m>
                </p>
              </li>

              <li>
                <p>
                  <m>x = 1</m>
                </p>
              </li>
            </ol>
          </p>
        </statement>

        <solution>
          <p>
            A.
          </p>
        </solution>
      </task>
    </exercise>
  </page>


  <page>
    <exercise>
      <introduction>
        <p>
          Evaluate the Laplace transforms of the following functions:
        </p>
      </introduction>


      <task>
        <statement>
          <p>
            <m>\displaystyle{f(t) = u(t - \pi)\cos(3(t - \pi))}</m>
          </p>
        </statement>

        <solution>
          <p>
            <m>\L\{ u(t - \pi) \cos(3(t -\pi))\} = \frac{e^{-\pi s}s}{s^2 + 3^2} </m>
          </p>
        </solution>
      </task>


      <task>
        <statement>
          <p>
            <m>\displaystyle{f(t) = \sin(5t) + 4\delta(t - 1) + 2t^3}</m>
          </p>
        </statement>

        <solution>
          <p>
            <m>\L\{ \sin(5t) + 4\delta(t - 1) + 2t^3\} = \frac{5}{s^2 + 5^2} + 4e^{-s} + 2 \cdot \frac{3!}{s^{3 + 1}}</m>
          </p>
        </solution>
      </task>


      <task>
        <statement>
          <p>
            <m>\displaystyle{f(t) = e^{-2t} t^5 + 3}</m>
          </p>
        </statement>

        <solution>
          <p>
            <m>\L\{ e^{-2t} t^5 + 3\} = \frac{5!}{(s + 2)^{5 + 1}} + \frac{3}{s} </m>
          </p>
        </solution>
      </task>
    </exercise>
  </page>


  <page>
    <exercise>
      <statement>
        <p>
          Solve the differential equation: <m>\displaystyle{y'' + 9y = 4 \sec(3t)}</m>.
        </p>
      </statement>

      <solution>
        <p>
          The associated homogeneous equation has characteristic equation <m>r^2 + 9 = 0</m>, so the general solution is:
          <md>
            <mrow> y_c = C_1 \underbrace{\sin(3t)}_{y_1} + C_2 \underbrace{\cos(3t)}_{y_2} </mrow>
          </md>
          The Wronskian is:
          <md>
            <mrow> W \amp = \begin{vmatrix} \sin(3t) \amp \cos(3t) \\ 3\cos(3t) \amp -3\sin(3t) \end{vmatrix} </mrow>
            <mrow> \amp = -3\sin^2(3t) - 3\cos^2(3t) </mrow>
            <mrow> \amp = -3 </mrow>
          </md>
          Now:
          <md>
            <mrow> u_1' \amp = \frac{-\cos(3t) 4\sec(3t)}{-3} = \frac{4}{3} \amp u_1 \amp = \frac{4t}{3} </mrow>
            <mrow> u_2' \amp = \frac{\sin(3t) 4\sec(3t)}{-3} = \frac{-4}{3} \tan(3t) \amp u_2 \amp = \frac{-4}{9} \ln|\sec(3t)| </mrow>
          </md>
          Finally, the general solution is:
          <md>
            <mrow> y \amp = y_c + y_p </mrow>
            <mrow> \amp = C_1 \sin(3t) + C_2 \cos(3t) + \frac{4t \sin(3t)}{3} - \frac{4\ln|\sec(3t)|}{9} \cos(3t) </mrow>
          </md>
        </p>
      </solution>
    </exercise>
  </page>


  <page>
    <exercise>
      <statement>
        <p>
          Evaluate <m>\displaystyle{\mathcal{L}^{-1}\left\{\frac{1}{s^2(s + 1)}\right\}}</m> using a convolution integral.
        </p>

        <p>
          (Work involving partial fractions decomposition will not receive credit for this problem.)
        </p>
      </statement>

      <solution>
        <p>
          <md>
            <mrow> \mathcal{L}^{-1}\left\{\frac{1}{s^2(s + 1)}\right\} \amp = \L \left\{\frac{1}{s^2}\right\} \ast \L \left\{\frac{1}{s + 1}\right\} </mrow>
            <mrow> \amp = t \ast e^{-t} </mrow>
            <mrow> \amp = \int_0^t (t - \tau)e^{-\tau}\ d\tau \amp u = t - \tau, v = -e^{-\tau} </mrow>
            <mrow> \amp = -(t - \tau)e^{-\tau}\bigg|_0^t - \int_0^t e^{-\tau}\ d\tau \amp du = -d\tau, dv = e^{-\tau}\ d\tau </mrow>
            <mrow> \amp = 0 - t - (-e^{-\tau})\bigg|_0^t</mrow>
            <mrow> \amp = 0 - t + e^{-t} + 1. </mrow>
          </md>
        </p>
      </solution>
    </exercise>
  </page>


  <page>
    <exercise>
      <statement>
        <p>
          Solve <m>\displaystyle{y'' + 4y = 5 \delta(t - 3)}</m>, <m>y(0) = 1</m>, <m>y'(0) = 0</m> using the Laplace transform.
        </p>
      </statement>

      <solution>
        <p>
          <md>
            <mrow> s^2Y - sy(0) - y'(0) + 4Y \amp = 5e^{-3s} </mrow>
            <mrow> (s^2 + 4)Y - s \amp = 5e^{-3s} </mrow>
            <mrow> Y \amp = \frac{s}{s^2 + 4} + \frac{5e^{-3s}}{s^2 + 4} </mrow>
            <mrow> y(t) \amp = \cos(2t) + \frac{5}{2}u(t - 3)\sin(2(t - 3)) </mrow>
          </md>
        </p>
      </solution>
    </exercise>
  </page>


  <page>
    <exercise>
      <statement>
        <p>
          Find the inverse Laplace transform: <m>\displaystyle{\mathcal{L}^{-1}\left\{\frac{8e^{-4s}}{s^2 + 2s - 3}\right\}}</m>.
        </p>
      </statement>

      <solution>
        <p>
          First, PFD:
          <md>
            <mrow> \frac{8}{(s + 3)(s - 1)} = \frac{A}{s + 3} + \frac{B}{s - 1} </mrow>
            <mrow> 8 \amp = A(s - 1) + B(s + 3) </mrow>
            <mrow> s = 1: \qquad 8 \amp = 4B \quad \Rightarrow \quad B = 2 \amp </mrow>
            <mrow> s = -3: \qquad 8 \amp = -4A \quad \Rightarrow \quad A = -2 \amp </mrow>
          </md>
          So:
          <md>
            <mrow> \L^{-1}\left\{ \frac{8e^{-4s}}{(s + 3)(s - 1)}\right\} \amp = \L^{-1}\left\{ \frac{-2e^{-4s}}{s + 3} + \frac{2e^{-4s}}{s - 1}\right\} </mrow>
            <mrow> \amp = -2 u(t - 4) e^{-3(t - 4)} + 2 u(t - 4) e^{t - 4} </mrow>
          </md>
        </p>
      </solution>
    </exercise>
  </page>


  <page>
    <exercise>
      <statement>
        <p>
          Calculate the determinants of the following matrices, and find the inverse of <m>A</m>.
          (You do not need to find the inverse of <m>B</m>.)
          <md>
            <mrow> A = \begin{bmatrix} 3 \amp 1 \\ -1 \amp -4 \end{bmatrix}, \qquad B = \begin{bmatrix} 2 \amp 1 \amp 3 \\ 1 \amp 3 \amp 4 \\ -2 \amp 1 \amp 1 \end{bmatrix} </mrow>
          </md>
        </p>
      </statement>

      <solution>
        <p>
          <md>
            <mrow> \begin{vmatrix} 3 \amp 1 \\ -1 \amp -4 \end{vmatrix} \amp = (3)(-4) - (1)(-1) = -11 </mrow>
            <mrow>  A^{-1} \amp = \frac{1}{-11} \begin{bmatrix} -4 \amp -1 \\ 1 \amp 3 \end{bmatrix} </mrow>
            <mrow> \begin{vmatrix} 2 \amp 1 \amp 3 \\ 1 \amp 3 \amp 4 \\ -2 \amp 1 \amp 1 \end{vmatrix} \amp = (2)(3)(1) + (1)(4)(-2) + (3)(1)(1)</mrow>
            <mrow> \amp \quad -(2)(4)(1) - (1)(1)(1) - (3)(3)(-2) </mrow>
            <mrow> \amp = 6 - 8 + 3 - 8 - 1 + 18 </mrow>
            <mrow> \amp = 10. </mrow>
          </md>
        </p>
      </solution>
    </exercise>
  </page>
</worksheet>