<?xml version="1.0" encoding="UTF-8"?>

<!-- When creating a new activity, make a copy of this file with appropriate name -->
<worksheet xml:id="recitation-Laplace-Periodic">
  <title>Transforms of Periodic Functions</title>

  <!-- Optional introduction -->
  <introduction>
    <p>
      Many functions that arise naturally when modeling various systems are periodic, so it's useful to see how the Laplace transform applies to such functions.
    </p>

    <theorem>
      <statement>
        <p>
          If <m>f(t)</m> is a function which is periodic with period <m>T</m>, then:
          <md>
            <mrow> \L\{f(t)\} = \frac{1}{1 - e^{-sT}} \int_0^T e^{-st}f(t)\ dt. </mrow>
          </md>
        </p>
      </statement>
    </theorem>
  </introduction>


  <page>
    <exercise>
      <statement>
        <p>
          Use the theorem (rather than the definition of <m>\L</m>) to calculate <m>\L\{\sin(t)\}</m>.
        </p>
      </statement>
    </exercise>
  </page>


  <page>
    <exercise>
      <statement>
        <p>
          A <term>square wave</term> is a function which displays periodic behavior by switching back and forth between a fixed maximum and minimum value, such as:
          <md>
            <mrow> f(t) = \begin{cases} 1 \amp 2n \leq t \lt 2n + 1 \\ 0 \amp 2n + 1 \leq t \lt 2n + 2 \end{cases}  </mrow>
          </md>
          Find <m>\L\{f(t)\}</m>.
        </p>
      </statement>
    </exercise>
  </page>
</worksheet>